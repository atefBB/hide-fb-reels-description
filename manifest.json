{
  "manifest_version": 3,
  "name": "Hide Facebook Reels Description",
  "version": "1.0.0",
  "description": "Hides the description/caption overlay on Facebook Reels videos so you can see the full video without obstruction.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.facebook.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Toggle Reels Description",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
